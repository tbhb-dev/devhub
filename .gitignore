.DS_Store
tmp/

# Build output and test artifacts
bin/
dist/
/coverage/
coverage.out
coverage.txt
*.coverprofile

# Node and nx
node_modules/
.nx/

# Python caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyrefly_cache/

# APM dependencies
apm_modules/

# Secrets and local overrides. mise.local.toml carries the private values;
# only mise.local.toml.example is tracked.
mise.local.toml
.env
.env.*
!.env.example

# Agent drafts, authored at the repo root so the Vale and cspell scopes
# resolve them, linted, consumed, and never committed.
COMMIT_AGENTMSG
PR_AGENTDESC.md
SQUASH_AGENTMSG

# Linter caches
.rumdl_cache/
.cspell-cache

# Agent worktrees and local harness settings
.worktrees/
.claude/worktrees/
.claude/settings.local.json
.codex/worktrees/
.codex/settings.local.json

# Vale's synced packages. Keep the repo-local style and its vocabulary;
# each negation needs its parent un-ignored first.
.vale/*
!.vale/project/
!.vale/config/
.vale/config/*
!.vale/config/vocabularies/
.vale/config/vocabularies/*
!.vale/config/vocabularies/project/

# Ansible collections installed from infra/ansible/requirements.yml, and
# the cache ansible-lint and Molecule keep beside a project
infra/ansible/.collections/
.ansible/
