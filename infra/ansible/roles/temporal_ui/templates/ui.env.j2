# {{ ansible_managed }}
TEMPORAL_ADDRESS={{ temporal_ui_frontend_address | to_json }}
TEMPORAL_TLS_SERVER_NAME={{ temporal_ui_tls_server_name | to_json }}
TEMPORAL_TLS_ENABLE_HOST_VERIFICATION=true
TEMPORAL_TLS_CA=/run/temporal-ui/ca.pem
TEMPORAL_TLS_CERT=/run/temporal-ui/certificate.pem
TEMPORAL_TLS_KEY=/run/temporal-ui/private-key.pem
TEMPORAL_DISABLE_WRITE_ACTIONS=true
TEMPORAL_CODEC_ENDPOINT={{ temporal_ui_codec_endpoint | to_json }}
TEMPORAL_UI_CERTIFICATE_VAULT={{ temporal_ui_client_certificate_vault | to_json }}
TEMPORAL_UI_CERTIFICATE_ITEM={{ temporal_ui_client_certificate_item | to_json }}
TEMPORAL_UI_TOKEN_FILE={{ (temporal_ui_home ~ '/' ~ temporal_ui_op_token_file) | to_json }}
