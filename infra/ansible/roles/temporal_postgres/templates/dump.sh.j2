#!/usr/bin/env bash
# cspell:ignore mmin
# {{ ansible_managed }}
set -euo pipefail
umask 077
export DOCKER_HOST=unix:///run/user/{{ docker_rootless_uid }}/docker.sock
directory={{ temporal_postgres_dump_dir | quote }}
dump="$directory/temporal-$(date -u +%Y%m%dT%H%M%S%N).sql"
trap 'rm -f -- "$dump.partial"' EXIT
for database in temporal temporal_visibility; do
  docker exec temporal-postgres pg_dump --username postgres --format plain --create "$database" >>"$dump.partial"
done
mv -- "$dump.partial" "$dump"
find "$directory" -maxdepth 1 -type f -name '*.sql' -mmin +{{ temporal_postgres_dump_retention_days * 1440 }} -delete
