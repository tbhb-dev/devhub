# Copy to mise.local.toml, fill in, and never commit the copy. The values
# below are placeholders only; real host names, addresses and account names
# belong in the gitignored mise.local.toml. The shared leak gate
# (devtools:lint-leaks) reads the real values from there and fails a
# commit or push that carries one.
[env]
# Comma-separated strings to keep out of the repository, such as host names,
# tailnet names, account names or project identifiers. May be empty. An entry
# under four characters is skipped, and an entry cannot contain a comma.
TECHOPS_PRIVATE_STRINGS = "host.example.invalid, project.example.invalid"
# ops:apply-scoped loads the ops key from 1Password into a private
# ssh-agent. The token file holds a service account's token, readable only
# by you; the vault, item and field name where the key is. With an SSH key
# item, the field takes the query that asks for OpenSSH format.
TECHOPS_APPLY_OP_TOKEN_FILE = "~/.config/techops/example-service-account-token"
TECHOPS_APPLY_OP_KEY_VAULT = "example-vault"
TECHOPS_APPLY_OP_KEY_ITEM = "example-ops-key"
TECHOPS_APPLY_OP_KEY_FIELD = "private key?ssh-format=openssh"
