{
  "language": "en",
  "ignorePaths": [
    "**/*.log",
    // Agent primitives deployed from tbhb-dev/devtools and pinned by
    // content hash in apm.lock.yaml. Their vocabulary is upstream's.
    ".agents/skills/**/*",
    ".claude/rules/**/*",
    ".claude/skills/**/*",
    ".claude/worktrees/**/*",
    ".worktrees/**/*",
    ".codex/worktrees/**/*",
    // The vendored devtools payload answers to the publisher's dictionary.
    ".config/mise/**/*",
    ".devtools/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    "apm.lock.yaml",
    // Vendored Go modules and their checksums are upstream's text.
    "go.mod",
    "go.sum",
    "vendor/**/*",
    "mise.lock",
    // Generated lockfiles and dependency/cache trees for the Python and
    // JS workspaces.
    "pnpm-lock.yaml",
    "uv.lock",
    "node_modules/**/*",
    ".nx/**/*",
    ".venv/**/*",
    // Private values, gitignored; nothing in it belongs in a dictionary.
    "mise.local.toml",
    "tmp/**/*",
    "vendir.lock.yml"
  ],
  "dictionaryDefinitions": [
    {
      "name": "techops",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["techops"]
}
