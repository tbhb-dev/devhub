# {{ ansible_managed }}
# Read by actions-runner-slot and actions-runner-slot-stop. No secret
# lives here: the 1Password references name where the App's key is, and
# the token stays in its own file.
ACTIONS_RUNNER_POOL_ORG={{ actions_runner_pool_org | quote }}
ACTIONS_RUNNER_POOL_APP_ID={{ actions_runner_pool_app_id | string | quote }}
ACTIONS_RUNNER_POOL_INSTALLATION_ID={{ actions_runner_pool_installation_id | string | quote }}
ACTIONS_RUNNER_POOL_RUNNER_GROUP_ID={{ actions_runner_pool_runner_group_id | string | quote }}
ACTIONS_RUNNER_POOL_LABELS={{ actions_runner_pool_labels | to_json | quote }}
ACTIONS_RUNNER_POOL_DNS={{ actions_runner_pool_dns | to_json | quote }}
ACTIONS_RUNNER_POOL_IMAGE={{ actions_runner_pool_image | quote }}
ACTIONS_RUNNER_POOL_CPUS={{ actions_runner_pool_cpus | quote }}
ACTIONS_RUNNER_POOL_MEMORY={{ actions_runner_pool_memory | quote }}
ACTIONS_RUNNER_POOL_PIDS_LIMIT={{ actions_runner_pool_pids_limit | string | quote }}
ACTIONS_RUNNER_POOL_WORK_SIZE={{ actions_runner_pool_work_size | quote }}
ACTIONS_RUNNER_POOL_OP_TOKEN_FILE={{ (actions_runner_pool_home ~ '/' ~ actions_runner_pool_op_token_file) | quote }}
ACTIONS_RUNNER_POOL_OP_KEY_VAULT={{ actions_runner_pool_op_key_vault | quote }}
ACTIONS_RUNNER_POOL_OP_KEY_ITEM={{ actions_runner_pool_op_key_item | quote }}
ACTIONS_RUNNER_POOL_OP_KEY_FIELD={{ actions_runner_pool_op_key_field | quote }}
ACTIONS_RUNNER_POOL_API_URL={{ actions_runner_pool_api_url | quote }}
ACTIONS_RUNNER_POOL_NAME_PREFIX={{ actions_runner_pool_name_prefix | quote }}
ACTIONS_RUNNER_POOL_HOST_ALIAS={{ inventory_hostname | quote }}
ACTIONS_RUNNER_POOL_CLEANUP_SECONDS={{ actions_runner_pool_cleanup_seconds | string | quote }}
