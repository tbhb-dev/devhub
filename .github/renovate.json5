{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The repository-level policy comes from two shared devtools presets:
  // renovate-config.json5 has the rules, grouping, and the custom managers
  // for pin sites no built-in manager reads, and renovate-go-config.json5
  // has the Go-module specifics (gomodTidy and the go-deps grouping). Both
  // are pinned to the same commit. devtools:check-pins reads the trailing
  // version comment on the first, and devtools:update-pins moves only that
  // one, so the Go preset line is moved by hand with it.
  //
  // The global-only options (identity, limits, requireConfig) are inlined
  // here rather than taken from globalExtends, which Renovate resolves
  // before host rules exist, so that fetch would run unauthenticated.
  requireConfig: "ignored",
  username: "tbhb-dev-renovate[bot]",
  gitAuthor: "tbhb-dev-renovate[bot] <289255489+tbhb-dev-renovate[bot]@users.noreply.github.com>",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  extends: [
    "github>tbhb-dev/devtools//.github/renovate-config.json5#d80265aa04fd10bbfe3965200ddbe3d5d1563c38", // v0.10.0
    "github>tbhb-dev/devtools//.github/renovate-go-config.json5#d80265aa04fd10bbfe3965200ddbe3d5d1563c38", // v0.10.0
  ],

  repositories: ["tbhb-dev/devhub"],
}
