log:
  stdout: true
  level: info
persistence:
  defaultStore: default
  visibilityStore: visibility
  numHistoryShards: 4
  datastores:
{% for store, database in [('default', 'temporal'), ('visibility', 'temporal_visibility')] %}
    {{ store }}:
      sql:
        pluginName: postgres12
        databaseName: {{ database }}
        connectAddr: {{ (temporal_server_postgres_host ~ ':5432') | to_json }}
        connectProtocol: tcp
        user: {{ temporal_server_postgres_user | to_json }}
        password: "__RUNTIME_PASSWORD__"
        maxConns: {{ 20 if store == 'default' else 2 }}
        maxIdleConns: {{ 20 if store == 'default' else 2 }}
        maxConnLifetime: 1h
{% endfor %}
global:
  membership:
    maxJoinDuration: 30s
    broadcastAddress: 127.0.0.1
  tls:
{% for group in ['internode', 'frontend'] %}
    {{ group }}:
      server:
        certFile: /tls/server.pem
        keyFile: /tls/server.key
        requireClientAuth: true
        clientCaFiles: [/tls/ca.pem]
      client:
        serverName: {{ temporal_server_tls_server_name | to_json }}
        rootCaFiles: [/tls/ca.pem]
{% endfor %}
    systemWorker:
      certFile: /tls/client.pem
      keyFile: /tls/client.key
      client:
        serverName: {{ temporal_server_tls_server_name | to_json }}
        rootCaFiles: [/tls/ca.pem]
services:
{% for service, port, membership in [('frontend', 7233, 6933), ('history', 7234, 6934), ('matching', 7235, 6935), ('worker', 7239, 6939)] %}
  {{ service }}:
    rpc:
      grpcPort: {{ port }}
      membershipPort: {{ membership }}
{% if service == 'frontend' %}
      bindOnIP: 0.0.0.0
{% else %}
      bindOnLocalHost: true
{% endif %}
{% endfor %}
clusterMetadata:
  enableGlobalNamespace: false
  failoverVersionIncrement: 10
  masterClusterName: active
  currentClusterName: active
  clusterInformation:
    active:
      enabled: true
      initialFailoverVersion: 1
      rpcName: frontend
      rpcAddress: 127.0.0.1:7233
dcRedirectionPolicy:
  policy: noop
archival:
  history: {state: disabled, enableRead: false}
  visibility: {state: disabled, enableRead: false}
namespaceDefaults:
  archival:
    history: {state: disabled}
    visibility: {state: disabled}
dynamicConfigClient:
  filepath: /dynamic.yml
  pollInterval: 10s
