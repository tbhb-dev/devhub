# {{ ansible_managed }}
[Unit]
Description=Temporal PostgreSQL
Requires=docker.service
After=docker.service

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=-{{ temporal_postgres_op_environment_file }}
ExecStart=%h/.local/bin/temporal-postgres-start
ExecStop=/usr/bin/docker stop --time 30 temporal-postgres
ExecStopPost=-/usr/bin/docker rm -f temporal-postgres
Environment=DOCKER_HOST=unix:///run/user/{{ docker_rootless_uid }}/docker.sock
TimeoutStartSec=240
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
