# {{ ansible_managed }}
# cspell:ignore tailscaled
[Unit]
Description=Temporal tailnet TCP service
Requires=tailscaled.service
After=tailscaled.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/env tailscale serve --bg --service={{ item.name }} --tcp={{ item.port }} tcp://127.0.0.1:{{ item.port }}
ExecStop=/usr/bin/env tailscale serve --service={{ item.name }} --tcp={{ item.port }} off

[Install]
WantedBy=multi-user.target
